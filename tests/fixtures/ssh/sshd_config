Port 22
PermitRootLogin no
PasswordAuthentication yes
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
AllowTcpForwarding yes
GatewayPorts no
X11Forwarding no
ClientAliveInterval 30
LogLevel VERBOSE
Subsystem sftp internal-sftp

# Test-only: the tunnel tests fail authentication and abandon handshakes on
# purpose (wrong password, refused host key), all from one source address.
# OpenSSH's per-source penalties would then drop the next tests' connections.
PerSourcePenalties no
MaxStartups 100:30:200
